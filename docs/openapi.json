  "components": {
    "schemas": {
      "AddTuitionRequest": {
        "properties": {
          "studentNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{3,20}$",
            "title": "Studentno",
            "examples": [
              "S1006"
            ]
          },
          "term": {
            "type": "string",
            "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$",
            "title": "Term",
            "examples": [
              "2027-SPRING"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "4000.00"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "title": "Currency",
            "examples": [
              "USD"
            ]
          }
        },
        "type": "object",
        "required": [
          "studentNo",
          "term",
          "amount",
          "currency"
        ],
        "title": "AddTuitionRequest"
      },
      "AddTuitionResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "UPDATED",
              "UNCHANGED"
            ],
            "title": "Status"
          },
          "studentNo": {
            "type": "string",
            "title": "Studentno"
          },
          "term": {
            "type": "string",
            "title": "Term"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "status",
          "studentNo",
          "term",
          "amount",
          "currency"
        ],
        "title": "AddTuitionResponse"
      },
      "BatchResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "COMPLETED",
            "title": "Status",
            "default": "COMPLETED"
          },
          "totalRows": {
            "type": "integer",
            "title": "Totalrows"
          },
          "successCount": {
            "type": "integer",
            "title": "Successcount"
          },
          "failureCount": {
            "type": "integer",
            "title": "Failurecount"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/BatchRowResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "totalRows",
          "successCount",
          "failureCount",
          "results"
        ],
        "title": "BatchResponse"
      },
      "BatchRowResult": {
        "properties": {
          "line": {
            "type": "integer",
            "title": "Line"
          },
          "studentNo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Studentno"
          },
          "term": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Term"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "UPDATED",
              "UNCHANGED",
              "FAILED"
            ],
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "line",
          "status"
        ],
        "title": "BatchRowResult"
      },
      "Body_admin_add_tuition_batch_api_v1_admin_tuition_batch_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "UTF-8 CSV file"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_admin_add_tuition_batch_api_v1_admin_tuition_batch_post"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaymentRequest": {
        "properties": {
          "studentNo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{3,20}$",
            "title": "Studentno",
            "examples": [
              "S1001"
            ]
          },
          "term": {
            "type": "string",
            "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$",
            "title": "Term",
            "examples": [
              "2026-FALL"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "examples": [
              "500.00"
            ]
          },
          "transactionId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 6,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Transactionid",
            "examples": [
              "bank-7f3c2a10"
            ]
          }
        },
        "type": "object",
        "required": [
          "studentNo",
          "term",
          "amount",
          "transactionId"
        ],
        "title": "PaymentRequest"
      },
      "PaymentResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "SUCCESS",
            "title": "Status",
            "default": "SUCCESS"
          },
          "transactionId": {
            "type": "string",
            "title": "Transactionid"
          },
          "studentNo": {
            "type": "string",
            "title": "Studentno"
          },
          "term": {
            "type": "string",
            "title": "Term"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "paidAmount": {
            "type": "number",
            "title": "Paidamount",
            "description": "Amount recorded by this payment"
          },
          "totalPaid": {
            "type": "number",
            "title": "Totalpaid",
            "description": "Total paid for the term so far"
          },
          "remainingBalance": {
            "type": "number",
            "title": "Remainingbalance"
          }
        },
        "type": "object",
        "required": [
          "transactionId",
          "studentNo",
          "term",
          "currency",
          "paidAmount",
          "totalPaid",
          "remainingBalance"
        ],
        "title": "PaymentResponse"
      },
      "TermBalance": {
        "properties": {
          "term": {
            "type": "string",
            "title": "Term"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "tuitionTotal": {
            "type": "number",
            "title": "Tuitiontotal"
          },
          "paidAmount": {
            "type": "number",
            "title": "Paidamount"
          },
          "balance": {
            "type": "number",
            "title": "Balance"
          }
        },
        "type": "object",
        "required": [
          "term",
          "currency",
          "tuitionTotal",
          "paidAmount",
          "balance"
        ],
        "title": "TermBalance"
      },
      "TokenRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Username",
            "examples": [
              "s1001"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password",
            "examples": [
              "Passw0rd!"
            ]
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "TokenRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "studentNo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Studentno"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "role"
        ],
        "title": "TokenResponse"
      },
      "TuitionSummary": {
        "properties": {
          "studentNo": {
            "type": "string",
            "title": "Studentno"
          },
          "scope": {
