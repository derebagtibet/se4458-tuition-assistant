{
  "openapi": "3.1.0",
  "info": {
    "title": "University Tuition API",
    "description": "\nTuition backend used by the University Mobile App, the Banking App, the Admin web site and the\nAI Tuition Assistant. **All public traffic goes through the API Gateway (Kong)**.\n\nAuthentication: call `POST /api/v1/auth/token`, then click **Authorize** and paste the token.\nDemo users: `s1001 / Passw0rd!` (student), `bankapp / Bank123!` (bank), `admin / Admin123!` (admin).\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in and obtain a JWT",
        "operationId": "issue_token_api_v1_auth_token_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mobile/tuition/{student_no}": {
      "get": {
        "tags": [
          "University Mobile App"
        ],
        "summary": "Query Tuition (no auth, max 3 calls per student per day)",
        "operationId": "mobile_query_tuition_api_v1_mobile_tuition__student_no__get",
        "parameters": [
          {
            "name": "student_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{3,20}$",
              "examples": [
                "S1001"
              ],
              "title": "Student No"
            }
          },
          {
            "name": "term",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional. If given, totals are for this term only (scope=TERM); otherwise totals are the overall balance across all terms (scope=OVERALL).",
              "title": "Term"
            },
            "description": "Optional. If given, totals are for this term only (scope=TERM); otherwise totals are the overall balance across all terms (scope=OVERALL)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TuitionSummary"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          }
        }
      }
    },
    "/api/v1/banking/tuition/{student_no}": {
      "get": {
        "tags": [
          "Banking App"
        ],
        "summary": "Query Tuition (authenticated)",
        "operationId": "banking_query_tuition_api_v1_banking_tuition__student_no__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "student_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{3,20}$",
              "examples": [
                "S1001"
              ],
              "title": "Student No"
            }
          },
          {
            "name": "term",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$"
