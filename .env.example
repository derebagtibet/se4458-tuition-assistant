# Copy to .env and fill in. Never commit the real .env.
POSTGRES_PASSWORD=change-me-local
# Shared HS256 secret between the Tuition API (token issuer) and Kong (JWT verification). Letters/digits only.
JWT_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32
JWT_ISSUER=tuition-auth
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: use another host port (e.g. 8002) if 8001 is already occupied.
MCP_HOST_PORT=8001
